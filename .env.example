# Скопируйте в .env и поменяйте пароли

POSTGRES_DB=altium_library
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
# владелец схем — под ним выполняются миграции (сервис migrate)
LIBRARY_OWNER_PASSWORD=change_me_owner
# роль только для чтения — её логин/пароль указываются в .DbLib (ODBC)
ALTIUM_READER_PASSWORD=change_me_altium
# роль сайта
LIBRARY_WEB_PASSWORD=change_me_web

# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change_me_secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# при доступе по имени/IP, отличному от localhost: http://library.local:8000
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 — каталог только для вошедших пользователей
DJANGO_LOGIN_REQUIRED=0

# администратор создаётся при старте, если его ещё нет
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change_me_admin
DJANGO_SUPERUSER_EMAIL=

PG_PORT=5432
WEB_PORT=8000
